generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wallet {
  address        String    @id
  label          String?
  source         String?
  createdAt      DateTime  @default(now())
  lastAnalyzedAt DateTime?
  status         String    @default("idle")
  metrics        String? // JSON WalletMetrics
  error          String?
}

model Token {
  mint      String   @id
  symbol    String?
  name      String?
  fetchedAt DateTime @default(now())
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  data      String // JSON RecommendationsData
}

model GemsRun {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  data      String // JSON GemsRunData
}
