generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wallet {
  address        String    @id
  label          String?
  source         String?
  createdAt      DateTime  @default(now())
  lastAnalyzedAt DateTime?
  status         String    @default("idle")
  metrics        String? // JSON WalletMetrics
  error          String?
  purgedAt       DateTime? // soft-deleted junk: hidden everywhere, knowledge retained
  subscribed     Boolean   @default(false) // live feed follows this wallet
  ownerId        Int? // cluster assignment from the owner graph (rebuilt, not stable across rebuilds)
  scoreAtAbsorb  Float? // frozen at first analysis — the cohort experiment's independent variable
  pnlAtAbsorb    Float? // realized PnL at that moment; forward PnL = current - this
  balanceSol     Float? // cached at analysis time — stale beats a hot-path RPC for sizing
  balanceAt      DateTime?
  lastEventAt    DateTime? // live feed touch — 'last active' without rewriting the metrics blob
  // OBSERVED performance: round trips we watched end to end.Historical PnL from a
  // truncated scan booked unbacked sells as profit; these cannot, because a
  // trade only counts once we have seen its buy.
  observedRealizedSol Float @default(0)
  observedTrades      Int   @default(0)
  observedWins        Int   @default(0)
  // open book marked to market by a periodic sweep — too expensive to price
  // 1600 wallets on every list request, cheap as a background pass
  unrealizedSol       Float?
  unrealizedCostSol   Float?
  unrealizedPositions Int?
  unrealizedPriced    Int?
  unrealizedAt        DateTime?
  copyability    String? // JSON CopyabilityResult — whale edge re-simulated with copy latency
}

model Token {
  mint          String    @id
  symbol        String?
  name          String?
  fetchedAt     DateTime  @default(now())
  tracked       Boolean   @default(false)
  source        String?
  addedAt       DateTime?
  lastCheckedAt DateTime?
  lastReport    String? // JSON TokenReport
  purgedAt      DateTime? // soft-deleted junk: hidden from lists, knowledge retained
  deepScannedAt DateTime? // crawler already mined this token's whole-life buyers
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  data      String // JSON RecommendationsData
}

model GemsRun {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  data      String // JSON GemsRunData
}

model CrawlerConfig {
  id   Int    @id @default(1)
  data String // JSON CrawlerConfig
}

model CrawlerRun {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  data       String // JSON { stats, log }
}

model LiveEvent {
  id        Int      @id @default(autoincrement())
  wallet    String
  signature String   @unique
  ts        DateTime
  kind      String // buy | sell | other
  mint      String?
  sol       Float
  usd       Float
  createdAt DateTime @default(now())

  @@index([ts])
}

model Opportunity {
  id        Int      @id @default(autoincrement())
  kind      String   @default("token") // token | wallet (owner rotation)
  mint      String?
  symbol    String?
  wallet    String // token: the buyer · rotation: the NEW wallet
  funder    String? // rotation: the subscribed wallet that funded it
  verdict   String
  buySol    Float // rotation: SOL funded
  ts        DateTime
  createdAt DateTime @default(now())

  @@index([mint, createdAt])
  signal        String    @default("copy") // copy = one whale's entry · consensus = N distinct owners in the window
  // Fill audit. The gap between what the whale paid and what we could get is
  // the single most load-bearing assumption in the system, and it was never
  // recorded — only the decision it produced. Without these, a stale price feed
  // and a real price spike look identical after the fact.
  whalePriceUsd  Float?
  marketPriceUsd Float? // our quotable price at the moment we decided
  fillGapPct     Float? // market vs whale, signed
}

model OpportunityConfig {
  id   Int    @id @default(1)
  data String // JSON OpportunityConfig
}

model WalletEdge {
  id        Int      @id @default(autoincrement())
  a         String // address (a < b, normalized)
  b         String
  type      String // funding | feepayer | coentry
  weight    Float
  createdAt DateTime @default(now())

  @@unique([a, b, type])
}

model PaperPosition {
  id            Int       @id @default(autoincrement())
  mint          String
  symbol        String?
  wallet        String?
  sizeSol       Float
  entryPriceUsd Float
  openedAt      DateTime  @default(now())
  status        String    @default("open") // open | closed
  exitPriceUsd  Float?
  exitReason    String? // tp | sl | timeout | manual
  closedAt      DateTime?
  pnlSol        Float?
  pnlPct        Float?
  mode          String    @default("paper")
  whaleEntryPriceUsd Float? // the trigger wallet's own fill — latency cost = ours vs theirs

  @@index([status])
  peakPriceUsd      Float? // set when a whale exit arms the trailing stop on a winner
  signal            String   @default("copy") // which entry logic opened this — expectancy splits by it
  wouldBlock        String? // guards that WOULD have blocked this entry, had they been enabled — within-run attribution
}

model ShadowPosition {
  id            Int       @id @default(autoincrement())
  mint          String
  symbol        String?
  wallet        String
  reason        String // which guard skipped it — the counterfactual being measured
  entryPriceUsd Float
  sizeSol       Float // what we would plausibly have risked
  openedAt      DateTime  @default(now())
  status        String    @default("open")
  closedAt      DateTime?
  exitPriceUsd  Float?
  pnlPct        Float?
  pnlSol        Float?
  allReasons    String? // EVERY guard that objected, not just the first — the co-occurrence matrix
  peakPriceUsd Float? // highest price seen while the phantom was open
  peakRetPct   Float? // what a trailing exit could have captured — buy-and-hold hides the path
}

/// Live position ledger: seeded from each analysis, incremented by every live
/// buy/sell. Replaces re-parsing 800+ stale metrics blobs to answer "who holds
/// what right now" — analysis is the periodic truth, events keep it current.
model RosterPosition {
  id        Int      @id @default(autoincrement())
  wallet    String
  mint      String
  symbol    String?
  qty       Float
  costSol   Float
  source    String   @default("analysis") // analysis | live — how the last update arrived
  updatedAt DateTime @updatedAt

  @@unique([wallet, mint])
  @@index([mint])
}

/// Phase 1 of the accumulation strategy: does conviction rank predict return?
/// Hourly snapshot of the top conviction tokens plus a random control group,
/// marked to market at +6h and +24h.
model ConvictionSnapshot {
  id        Int      @id @default(autoincrement())
  mint      String
  symbol    String?
  cohort    String // rank band: "1-5" | "6-10" | "11-20" | "control"
  rank      Int?
  score     Float?
  owners    Int?
  priceUsd  Float
  takenAt   DateTime @default(now())
  price6h   Float?
  ret6hPct  Float?
  price24h  Float?
  ret24hPct Float?
  price72h  Float?
  ret72hPct Float?

  @@index([takenAt])
}

/// Every round trip we watched close: entry seen, exit seen, cost basis real.
/// The only source for "where the roster printed" and for wallet scoring.
model ObservedTrade {
  id       Int      @id @default(autoincrement())
  wallet   String
  mint     String
  symbol   String?
  pnlSol   Float
  costSol  Float
  closedAt DateTime @default(now())

  @@index([wallet])
  @@index([mint])
}

/// Cached candle path for one replayed entry. Fetching candles is the slow,
/// rate-limited part of a backtest; scoring a strategy against a cached path is
/// microseconds. Caching turns parameter search from hours into milliseconds.
model BacktestPath {
  id        Int      @id @default(autoincrement())
  mint      String
  symbol    String?
  entryTs   Int // unix seconds
  entryPrice Float
  closes    String // JSON number[] — closes from entry forward, one per bar
  resolution String  @default("minute") // minute (8.3h reach) | hour (days)
  fetchedAt DateTime @default(now())

  @@unique([mint, entryTs, resolution])
}

/// Last backtest result, so it survives a restart. The run costs 20 minutes of
/// rate-limited fetching; losing its output to a process bounce is needless.
model BacktestRun {
  id      Int      @id @default(autoincrement())
  ranAt   DateTime @default(now())
  payload String // JSON BacktestResult
}

/// Why a token event did or did not become a trade. One row per decision,
/// persisted, so "why didn't it buy X?" still has an answer after a restart —
/// including the quiet, high-volume exits (buy too small, tokens passed straight
/// through a relay wallet) that used to leave no trace at all.
model Decision {
  id      Int      @id @default(autoincrement())
  ts      DateTime @default(now())
  mint    String?
  symbol  String?
  wallet  String?
  stage   String // event | signal | gauntlet | execution | trade
  outcome String // skip | shadow | fired | opened
  code    String // stable key, e.g. below-min-size — filters and counts group on it
  reason  String // the sentence the deck shows
  quiet   Boolean  @default(false) // routine skips, hidden unless asked for

  @@index([mint, ts])
  @@index([ts])
}
