generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wallet {
  address        String    @id
  label          String?
  source         String?
  createdAt      DateTime  @default(now())
  lastAnalyzedAt DateTime?
  status         String    @default("idle")
  metrics        String? // JSON WalletMetrics
  error          String?
  purgedAt       DateTime? // soft-deleted junk: hidden everywhere, knowledge retained
  subscribed     Boolean   @default(false) // live feed follows this wallet
}

model Token {
  mint          String    @id
  symbol        String?
  name          String?
  fetchedAt     DateTime  @default(now())
  tracked       Boolean   @default(false)
  source        String?
  addedAt       DateTime?
  lastCheckedAt DateTime?
  lastReport    String? // JSON TokenReport
  purgedAt      DateTime? // soft-deleted junk: hidden from lists, knowledge retained
  deepScannedAt DateTime? // crawler already mined this token's whole-life buyers
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  data      String // JSON RecommendationsData
}

model GemsRun {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  data      String // JSON GemsRunData
}

model CrawlerConfig {
  id   Int    @id @default(1)
  data String // JSON CrawlerConfig
}

model CrawlerRun {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  data       String // JSON { stats, log }
}

model LiveEvent {
  id        Int      @id @default(autoincrement())
  wallet    String
  signature String   @unique
  ts        DateTime
  kind      String // buy | sell | other
  mint      String?
  sol       Float
  usd       Float
  createdAt DateTime @default(now())

  @@index([ts])
}

model Opportunity {
  id        Int      @id @default(autoincrement())
  mint      String
  symbol    String?
  wallet    String
  verdict   String
  buySol    Float
  ts        DateTime
  createdAt DateTime @default(now())

  @@index([mint, createdAt])
}

model OpportunityConfig {
  id   Int    @id @default(1)
  data String // JSON OpportunityConfig
}
