generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wallet {
  address        String    @id
  label          String?
  source         String?
  createdAt      DateTime  @default(now())
  lastAnalyzedAt DateTime?
  status         String    @default("idle")
  metrics        String? // JSON WalletMetrics
  error          String?
  purgedAt       DateTime? // soft-deleted junk: hidden everywhere, knowledge retained
}

model Token {
  mint          String    @id
  symbol        String?
  name          String?
  fetchedAt     DateTime  @default(now())
  tracked       Boolean   @default(false)
  source        String?
  addedAt       DateTime?
  lastCheckedAt DateTime?
  lastReport    String? // JSON TokenReport
  purgedAt      DateTime? // soft-deleted junk: hidden from lists, knowledge retained
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  data      String // JSON RecommendationsData
}

model GemsRun {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  data      String // JSON GemsRunData
}

model CrawlerConfig {
  id   Int    @id @default(1)
  data String // JSON CrawlerConfig
}

model CrawlerRun {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  data       String // JSON { stats, log }
}
