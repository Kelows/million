DATABASE_URL="file:./dev.db"
# Free key at https://dashboard.helius.dev — required for wallet analysis
HELIUS_API_KEY=""
# Max enhanced-tx pages fetched per wallet analysis (100 txs/page)
ANALYSIS_MAX_PAGES=5
PORT=3001
# Public URL for Helius webhooks (e.g. an ngrok domain). When set, live
# ingestion uses webhooks (no subscription cap); otherwise websockets.
WEBHOOK_URL=""
# Shared secret Helius sends back in the Authorization header
WEBHOOK_SECRET=""

# ── live trading (LocalExecutor) ─────────────────────────────────────────────
# EXECUTOR=local signs REAL transactions with the keypair below. Leave unset for paper.
# Entries additionally require the autoTrade toggle in the Opportunities config (two-key launch).
#EXECUTOR=local
# solana-keygen style JSON keypair (64-byte array). Keep OUTSIDE the repo. Fund only what you can lose.
#EXECUTOR_KEYPAIR_PATH=~/.million/keypair.json
# executor-level hard rails (defense in depth under the strategy caps)
#LOCAL_MAX_TRADE_SOL=0.25
#LOCAL_MIN_BALANCE_SOL=0.05
